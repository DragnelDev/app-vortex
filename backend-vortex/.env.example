# Copie este archivo a `.env` y ajuste los valores. `.env` NO se versiona.

# Genere una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=cambie-esta-clave
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/La_Paz

# Usuario administrador local (configure una contraseña propia antes de crearlo).
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=

# PostgreSQL
DB_NAME=vortex
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Frontend permitido (CORS / CSRF)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# JWT y paginación
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
PAGE_SIZE=25
